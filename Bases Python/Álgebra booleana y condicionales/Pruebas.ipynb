   "source": [
    "texto = input(\"Escribe una frase: \")\n",
    "conteo = {}\n",
    "####################\n",
    "\n",
    "palabra = texto.split()\n",
    "for dato in palabra:\n",
    "    if dato not in conteo:\n",
    "        conteo[dato] = 1\n",
    "    else:\n",
    "        conteo[dato] = conteo[dato] + 1\n",
    "conteo"
